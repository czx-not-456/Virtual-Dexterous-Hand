{
  "description": "实验 v2 姿态与轨迹配置（CH-M6，6-DOF: thumb_rotation/thumb_bend/index/middle/ring/pinky，单位=度）",
  "notes": [
    "所有 target 仅作为机械手驱动名义值；真实目标 = 编码器读回（get_actual_joint_angles）",
    "姿态选择原则：人手能自然做出的常见手势，同时覆盖各关节工作空间（含拇指侧摆）",
    "Group C 的 held-out 姿态/轨迹必须与 A/B 无重叠（不同角度组合/不同轨迹）"
  ],

  "calibration_poses": [
    {"name": "open",          "target": [  0,  0,  0,  0,  0,  0]},
    {"name": "index_pinch",   "target": [ 60, 40, 45,  0,  0,  0]},
    {"name": "tripod",        "target": [ 65, 42, 45, 45,  0,  0]},
    {"name": "half_fist",     "target": [  0,  0, 45, 45, 45, 45]},
    {"name": "full_fist",     "target": [ 70, 50, 80, 80, 80, 80]},
    {"name": "thumb_touch",   "target": [ 45, 35, 30,  0,  0,  0]},
    {"name": "thumb_high",    "target": [ 80, 35, 55, 55, 55, 55]},
    {"name": "point",         "target": [ 20, 25, 20, 70, 70, 70]},
    {"name": "hook_fist",     "target": [  0,  0, 80, 80, 80, 80]},
    {"name": "thumb_mid",     "target": [ 30, 20,  0, 45,  0,  0]}
  ],

  "calibration_sweeps": [
    {"name": "open_to_fist",      "start": [  0,  0,  0,  0,  0,  0], "end": [70, 50, 80, 80, 80, 80], "steps": 40},
    {"name": "thumb_rot_sweep",   "start": [ 15, 30,  0,  0,  0,  0], "end": [85, 30,  0,  0,  0,  0], "steps": 30},
    {"name": "fingers_sweep",     "start": [  0,  0, 15, 15, 15, 15], "end": [ 0,  0, 80, 80, 80, 80], "steps": 35},
    {"name": "index_only_sweep",  "start": [ 30, 25, 10,  0,  0,  0], "end": [40, 30, 80,  0,  0,  0], "steps": 30},
    {"name": "pinch_to_half",     "start": [ 60, 40, 45,  0,  0,  0], "end": [  0,  0, 45, 45, 45, 45], "steps": 35},
    {"name": "thumb_rot_grasp",   "start": [ 20, 35, 40, 40, 40, 40], "end": [ 85, 45, 70, 70, 70, 70], "steps": 35}
  ],

  "heldout_poses": [
    {"name": "mid_pinch",        "target": [ 50, 38, 55,  0,  0,  0]},
    {"name": "mid_tripod",       "target": [ 55, 40, 50, 55,  0,  0]},
    {"name": "thumb_45_grasp",   "target": [ 45, 40, 60, 60, 60, 60]},
    {"name": "ring_pinky",       "target": [  0,  0,  0,  0, 65, 65]},
    {"name": "pinch_middle20",   "target": [ 60, 40, 45, 20,  0,  0]},
    {"name": "two_finger_pinch", "target": [ 50, 30, 55,  0, 55,  0]}
  ],

  "heldout_sweeps": [
    {"name": "tripod_to_half",     "start": [ 65, 42, 45, 45,  0,  0], "end": [ 0,  0, 45, 45, 45, 45], "steps": 35},
    {"name": "open_to_thumb_high", "start": [  0,  0,  0,  0,  0,  0], "end": [80, 35, 55, 55, 55, 55], "steps": 35},
    {"name": "thumb_mid_to_full",  "start": [ 30, 20,  0, 45,  0,  0], "end": [70, 50, 80, 80, 80, 80], "steps": 35},
    {"name": "point_to_hook",      "start": [ 20, 25, 20, 70, 70, 70], "end": [ 0,  0, 80, 80, 80, 80], "steps": 35}
  ],

  "recording": {
    "pose_reps": 5,
    "pose_hold_sec": 0.8,
    "sweep_hold_sec": 0.6,
    "robot_settle_sec": 1.2,
    "target_tolerance_deg": 3.0
  }
}
