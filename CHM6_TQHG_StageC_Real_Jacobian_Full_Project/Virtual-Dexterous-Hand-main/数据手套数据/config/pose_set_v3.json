{
  "description": "实验 v3 姿态与轨迹配置（CH-M6，6-DOF: thumb_rotation/thumb_bend/index/middle/ring/pinky，单位=度）\nthumb_bend 上限 35° 对应 Qn_glove URDF th_mcp limit 0.62 rad，其余关节上限 90°/100°",
  "notes": [
    "所有 target 仅作为机械手驱动名义值；真实目标 = 编码器读回（get_actual_joint_angles）",
    "A/B 沿用 v2 并做四处关键改动：B 改为双向升/降程；A 重复间强制松手；C 拆 C1/C2；引入稳定性门控",
    "C2（凸包外）的极端角度为初版，M1 期间必须经真机点动确认可达后再锁定",
    "endpoint_trim_frac 用于 C1 扫掠：剔除首尾各 15% waypoint，避免端点即标定姿态"
  ],

  "calibration_poses": [
    {"name": "open",          "target": [  0,  0,  0,  0,  0,  0]},
    {"name": "index_pinch",   "target": [ 60, 28, 45,  0,  0,  0]},
    {"name": "tripod",        "target": [ 65, 30, 45, 45,  0,  0]},
    {"name": "half_fist",     "target": [  0,  0, 45, 45, 45, 45]},
    {"name": "full_fist",     "target": [ 70, 30, 80, 80, 80, 80]},
    {"name": "thumb_touch",   "target": [ 45, 28, 30,  0,  0,  0]},
    {"name": "thumb_high",    "target": [ 80, 28, 55, 55, 55, 55]},
    {"name": "point",         "target": [ 20, 25, 20, 70, 70, 70]},
    {"name": "hook_fist",     "target": [  0,  0, 80, 80, 80, 80]},
    {"name": "thumb_mid",     "target": [ 30, 20,  0, 45,  0,  0]}
  ],

  "calibration_sweeps": [
    {"name": "open_to_fist",      "start": [  0,  0,  0,  0,  0,  0], "end": [70, 30, 80, 80, 80, 80], "steps": 40, "bidirectional": true},
    {"name": "thumb_rot_sweep",   "start": [ 15, 25,  0,  0,  0,  0], "end": [85, 25,  0,  0,  0,  0], "steps": 30, "bidirectional": true},
    {"name": "fingers_sweep",     "start": [  0,  0, 15, 15, 15, 15], "end": [ 0,  0, 80, 80, 80, 80], "steps": 35, "bidirectional": true},
    {"name": "index_only_sweep",  "start": [ 30, 20, 10,  0,  0,  0], "end": [40, 25, 80,  0,  0,  0], "steps": 30, "bidirectional": true},
    {"name": "pinch_to_half",     "start": [ 60, 28, 45,  0,  0,  0], "end": [  0,  0, 45, 45, 45, 45], "steps": 35, "bidirectional": true},
    {"name": "thumb_rot_grasp",   "start": [ 20, 25, 40, 40, 40, 40], "end": [ 85, 30, 70, 70, 70, 70], "steps": 35, "bidirectional": true}
  ],

  "heldout_c1_poses": [
    {"name": "mid_pinch",        "target": [ 50, 28, 55,  0,  0,  0]},
    {"name": "mid_tripod",       "target": [ 55, 30, 50, 55,  0,  0]},
    {"name": "thumb_45_grasp",   "target": [ 45, 30, 60, 60, 60, 60]},
    {"name": "ring_pinky",       "target": [  0,  0,  0,  0, 65, 65]},
    {"name": "pinch_middle20",   "target": [ 60, 28, 45, 20,  0,  0]},
    {"name": "two_finger_pinch", "target": [ 50, 28, 55,  0, 55,  0]}
  ],

  "heldout_c1_sweeps": [
    {"name": "tripod_to_half",     "start": [ 65, 30, 45, 45,  0,  0], "end": [ 0,  0, 45, 45, 45, 45], "steps": 35, "bidirectional": true},
    {"name": "open_to_thumb_high", "start": [  0,  0,  0,  0,  0,  0], "end": [80, 28, 55, 55, 55, 55], "steps": 35, "bidirectional": true},
    {"name": "thumb_mid_to_full",  "start": [ 30, 20,  0, 45,  0,  0], "end": [70, 30, 80, 80, 80, 80], "steps": 35, "bidirectional": true},
    {"name": "point_to_hook",      "start": [ 20, 25, 20, 70, 70, 70], "end": [ 0,  0, 80, 80, 80, 80], "steps": 35, "bidirectional": true}
  ],

  "heldout_c2_poses": [
    {"name": "thumb_rot_extreme",    "target": [ 90, 28,  0,  0,  0,  0], "note": "Qn_glove URDF th_cmc 上限 100°，留余量取 90°"},
    {"name": "thumb_bend_extreme",   "target": [ 30, 35,  0,  0,  0,  0], "note": "Qn_glove URDF th_mcp 上限 0.62 rad ≈ 35.5°，取 35°"},
    {"name": "pinky_independent",    "target": [  0,  0,  0,  0,  0, 85], "note": "小指独立弯曲上限 90°"},
    {"name": "ring_thumb_opposition", "target": [ 70, 28,  0,  0, 75,  0], "note": "A/B 未覆盖的 ring + thumb rotation 组合"},
    {"name": "index_pinky_spread",   "target": [ 20, 25, 75,  0,  0, 75], "note": "A/B 未覆盖的 index + pinky 同时弯曲"},
    {"name": "thumb_rot_open_fist",  "target": [ 90, 30, 80, 80, 80, 80], "note": "高拇指旋转 + 全握拳的极端组合"}
  ],

  "heldout_c2_sweeps": [
    {"name": "thumb_rot_outer",   "start": [ 85, 28,  0,  0,  0,  0], "end": [ 95, 30, 40, 40, 40, 40], "steps": 30, "bidirectional": true, "note": "拇指旋转外推"},
    {"name": "pinky_outer",       "start": [  0,  0,  0,  0,  0, 10], "end": [  0,  0,  0,  0,  0, 90], "steps": 30, "bidirectional": true, "note": "小指独立外推"}
  ],

  "recording": {
    "pose_reps": 5,
    "pose_hold_sec": 0.8,
    "sweep_hold_sec": 0.6,
    "robot_settle_sec": 1.2,
    "target_tolerance_deg": 3.0,
    "endpoint_trim_frac": 0.15,
    "release_between_reps": true,
    "stability_std_thresh": 2.0,
    "stability_window_frames": 12
  }
}
